{
    "name": "alborsa/alborsa-platform",
    "description": "Modular WordPress product plugin for alborsa.net.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "brain/monkey": "^2.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "php-stubs/wordpress-stubs": "^6.6",
        "php-stubs/wp-cli-stubs": "^2.11",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "Alborsa\\Platform\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Alborsa\\Platform\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude .phpstan-cache --exclude .phpunit.cache .",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "test:unit": "phpunit",
        "quality": [
            "@lint",
            "@phpcs",
            "@phpstan",
            "@test:unit"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    }
}
