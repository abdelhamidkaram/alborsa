{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {"slug": "midnight-market", "color": "#0A1628", "name": "كحلي السوق"},
        {"slug": "newsroom-navy", "color": "#122040", "name": "كحلي غرفة الأخبار"},
        {"slug": "tadawul-gold", "color": "#C9A84C", "name": "ذهبي تداول"},
        {"slug": "data-teal", "color": "#0D7377", "name": "تيل البيانات"},
        {"slug": "cool-surface", "color": "#F2F5FA", "name": "سطح بارد"},
        {"slug": "surface-raised", "color": "#FFFFFF", "name": "سطح مرتفع"},
        {"slug": "ink-primary", "color": "#16243A", "name": "حبر أساسي"},
        {"slug": "market-up", "color": "#1A7A4A", "name": "ارتفاع"},
        {"slug": "market-down", "color": "#C0392B", "name": "انخفاض"}
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1408px"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {"slug": "20", "size": "0.5rem", "name": "صغير"},
        {"slug": "40", "size": "1rem", "name": "متوسط"},
        {"slug": "60", "size": "1.5rem", "name": "كبير"},
        {"slug": "80", "size": "2rem", "name": "أكبر"},
        {"slug": "100", "size": "3rem", "name": "قسم"}
      ],
      "units": ["px", "rem", "em", "%", "vw"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Noto Kufi Arabic\", \"Cairo\", Tahoma, sans-serif",
          "name": "عرض عربي",
          "slug": "display-arabic"
        },
        {
          "fontFamily": "\"Noto Sans Arabic\", \"Cairo\", Tahoma, Arial, sans-serif",
          "name": "نص عربي",
          "slug": "body-arabic"
        }
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.875rem", "name": "صغير"},
        {"slug": "medium", "size": "1rem", "name": "أساسي"},
        {"slug": "large", "size": "1.25rem", "name": "كبير"},
        {"slug": "x-large", "size": "clamp(1.75rem, 3vw, 3rem)", "name": "عنوان"}
      ],
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "#F2F5FA",
      "text": "#16243A"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|body-arabic",
      "fontSize": "1rem",
      "lineHeight": "1.8"
    },
    "elements": {
      "button": {
        "border": {"radius": "8px"},
        "color": {"background": "#C9A84C", "text": "#0A1628"},
        "spacing": {"padding": {"top": "0.75rem", "right": "1.25rem", "bottom": "0.75rem", "left": "1.25rem"}},
        "typography": {"fontWeight": "700"}
      },
      "heading": {
        "color": {"text": "#16243A"},
        "typography": {"fontFamily": "var:preset|font-family|display-arabic", "fontWeight": "700", "lineHeight": "1.3"}
      },
      "link": {
        "color": {"text": "#0D7377"}
      }
    }
  }
}
