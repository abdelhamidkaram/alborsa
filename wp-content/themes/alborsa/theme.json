{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {"slug": "paper", "color": "#FDFCFA", "name": "ورق"},
        {"slug": "card", "color": "#FFFFFF", "name": "بطاقة"},
        {"slug": "ink", "color": "#15181C", "name": "حبر"},
        {"slug": "body", "color": "#4B5058", "name": "نص"},
        {"slug": "muted", "color": "#686D75", "name": "خافت"},
        {"slug": "rule", "color": "#E3DDD1", "name": "فاصل"},
        {"slug": "cobalt", "color": "#1F45C9", "name": "كوبالت"},
        {"slug": "saffron", "color": "#F0B23A", "name": "زعفران"},
        {"slug": "market-up", "color": "#12784F", "name": "ارتفاع"},
        {"slug": "market-down", "color": "#C2352B", "name": "انخفاض"}
      ]
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1440px"
    },
    "spacing": {
      "blockGap": true,
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {"slug": "10", "size": "0.25rem", "name": "4"},
        {"slug": "20", "size": "0.5rem", "name": "8"},
        {"slug": "30", "size": "0.75rem", "name": "12"},
        {"slug": "40", "size": "1rem", "name": "16"},
        {"slug": "50", "size": "1.5rem", "name": "24"},
        {"slug": "60", "size": "2rem", "name": "32"},
        {"slug": "70", "size": "3rem", "name": "48"},
        {"slug": "80", "size": "4rem", "name": "64"}
      ],
      "units": ["px", "rem", "em", "%", "vw"]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "\"Cairo\", Tahoma, Arial, sans-serif",
          "name": "Cairo",
          "slug": "cairo"
        }
      ],
      "fontSizes": [
        {"slug": "small", "size": "0.75rem", "name": "Small"},
        {"slug": "label", "size": "0.875rem", "name": "Label"},
        {"slug": "body", "size": "1rem", "name": "Body"},
        {"slug": "card-title", "size": "1.25rem", "name": "Card title"},
        {"slug": "heading-2", "size": "1.5rem", "name": "H2"},
        {"slug": "heading-1", "size": "1.875rem", "name": "H1"},
        {"slug": "hero", "size": "clamp(2.125rem, 3.6vw, 3.25rem)", "name": "Hero"}
      ],
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--color-page)",
      "text": "var(--color-text-body)"
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|cairo",
      "fontSize": "var(--font-size-body)",
      "fontWeight": "400",
      "lineHeight": "var(--line-height-body)"
    },
    "elements": {
      "button": {
        "border": {"radius": "8px"},
        "color": {"background": "var(--color-accent)", "text": "var(--color-accent-contrast)"},
        "spacing": {"padding": {"top": "0.875rem", "right": "1.25rem", "bottom": "0.875rem", "left": "1.25rem"}},
        "typography": {"fontWeight": "700"}
      },
      "heading": {
        "color": {"text": "var(--color-text)"},
        "typography": {"fontFamily": "var:preset|font-family|cairo", "lineHeight": "var(--line-height-heading)"}
      },
      "link": {
        "color": {"text": "var(--color-accent)"}
      }
    }
  }
}
